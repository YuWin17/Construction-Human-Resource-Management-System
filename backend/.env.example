APP_ENV=development
HTTP_ADDR=:8080
DATABASE_DRIVER=sqlite
DATABASE_DSN=./data/hrms.db
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_TTL_HOURS=8
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-now
DAILY_REMINDER_TOKEN=replace-with-a-long-random-token
TIMEZONE=Asia/Shanghai

# CloudBase production only. Keep the API key server-side; do not commit it.
# DATABASE_DRIVER=cloudbase_pg
# CLOUDBASE_ENV_ID=your-cloudbase-environment-id
# CLOUDBASE_API_KEY=server-side-api-key
# CLOUDBASE_PG_REST_BASE_URL=https://your-env.api.tcloudbasegateway.com/v1/rdb/rest
